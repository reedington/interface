# Optional: deterministic replay needs no model credentials.
# Alternatively, enter a provider key in the app's Settings (memory only).
# Explicit supported values here override inherited environment variables on startup.
# An empty value clears the inherited value; omit/comment an entry to inherit it.
# Restart the app after editing .env. Settings overrides last until shutdown.
# Only the provider and app variables documented below are loaded; PATH,
# NODE_OPTIONS and other shell/runtime variables are ignored in this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.5-flash
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_API_KEY, GEMINI_MODEL and GEMINI_BASE_URL are supported Google aliases.
# CHROME_PATH=/path/to/chrome
# WORKBENCH_PORT=4317
# The desktop starts against the real, local Mifos X stack by default.
# `npm run start:lab` explicitly selects the separate synthetic target.
INTERFACE_TARGET=mifos
MIFOS_URL=http://127.0.0.1:4200
MIFOS_TENANT=default
# For a second isolated stack, choose a new Compose project, unused MIFOS_URL
# port, fixture directory, worker data directory and WORKBENCH_PORT together.
# MIFOS_COMPOSE_PROJECT=interface-mifos
# MIFOS_FIXTURE_DIR=.local/mifos
# Select a separate config at launch with INTERFACE_ENV_FILE=/absolute/test.env.
# Author that file first; an explicitly selected missing file stops startup.
# These are credentials for the isolated local development stack, not a bank.
# Never reuse real banking credentials. Setup preserves an existing .env.
MIFOS_USERNAME=mifos
MIFOS_PASSWORD=password
# TARGET_PORT is only used by the explicit synthetic lab.
# TARGET_PORT=4318
# WORKBENCH_DATA_DIR=.local/data
